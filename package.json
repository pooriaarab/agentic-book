{
  "name": "agentic-book",
  "version": "0.1.2",
  "description": "Calendar API wrapper for Node.js with Google Calendar and Cal.com booking requests, Calendly availability requests, CLI, MCP, and offline previews.",
  "keywords": [
    "google-calendar",
    "cal.com",
    "calcom",
    "calendly",
    "calendar-api",
    "meeting-booking",
    "booking-preview",
    "availability",
    "freebusy",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "scheduling"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-book.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-book",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-book": "./dist/cli.js",
    "agentic-book-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0",
    "agentic-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
